# ChatBucket B2B backend (Node) — copy to .env and fill in.
#
# Every value here is read in src/config.ts and NOWHERE else. If you find
# process.env outside that module, it is a bug.

ENVIRONMENT=development
LOG_LEVEL=INFO
# 8001 by default so this can run alongside the Python service on 8000 and the
# two can be compared response by response during the cutover.
PORT=8001

# --- Database -----------------------------------------------------------------
# The SAME database as the Python service: during the cutover both read and
# write the same documents.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=chatbucket_b2b
MONGODB_BLOG_DB=chatbucket

# --- Tokens -------------------------------------------------------------------
# MUST match the Python service's JWT_SECRET, for two reasons: a token issued by
# one has to be accepted by the other while traffic is split, and verification
# codes are HMAC'd under this key — a different secret makes every outstanding
# OTP unverifiable. The process refuses to start in production if this is left
# at its default.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Verification -------------------------------------------------------------
REQUIRE_EMAIL_VERIFICATION=false
VERIFICATION_TOKEN_EXPIRE_HOURS=48
EMAIL_OTP_EXPIRE_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5

# --- Credits ------------------------------------------------------------------
# A string, not a number: it is an exact money amount and must not go near a
# binary float on the way in.
SIGNUP_BONUS_CREDITS=100
FREE_CREDIT_VALIDITY_DAYS=30

# --- CORS ---------------------------------------------------------------------
# Exact origins, comma-separated. Credentials are allowed, so a permissive value
# here would let any site read authenticated responses. Any localhost port is
# additionally allowed in development only.
CORS_ORIGINS=http://localhost:3000,https://chatbucket.business

# --- SMTP ---------------------------------------------------------------------
# auto = smtp when SMTP_HOST is set, else console.
EMAIL_BACKEND=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=support@chatbucket.business
EMAIL_FROM_NAME=ChatBucket
SUPPORT_EMAIL=support@chatbucket.business

# --- SMS / phone verification ---------------------------------------------------
# An Indian number verifies by SMS and is sent NO email code; every other country
# verifies by email. src/services/verification.ts owns that rule.
#
# auto = http when SMS_API_URL is set, else console.
SMS_BACKEND=auto
SMS_API_URL=
SMS_USERNAME=
SMS_API_KEY=
# The DLT-registered sender header and template id. India requires BOTH to be
# pre-registered with TRAI. An unregistered pair is dropped by the OPERATOR, not
# the gateway — so a wrong value here looks exactly like silent non-delivery,
# with a 200 from the gateway and "Delivered" in its report.
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
# For a registration whose template ends in a second variable. LEAVE EMPTY unless
# it really does: a trailing word the registration does not have makes the
# delivered text stop matching it, and the message is dropped invisibly. This is
# not hypothetical — a guessed suffix did exactly that in the Python service.
SMS_TEMPLATE_SUFFIX=
SMS_STRIP_COUNTRY_CODE=true
SMS_TIMEOUT_SECONDS=15
SMS_COUNTRY_CODES=+91
PHONE_OTP_EXPIRE_MINUTES=10
PHONE_OTP_MAX_ATTEMPTS=5
# How long a number proven on the signup form stays usable for creating the
# account. Bounded so a number verified once cannot be attached to an account
# somebody creates hours later.
PHONE_VERIFICATION_GRACE_MINUTES=30

# --- Links --------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
MARKETING_URL=https://chatbucket.business
DISPLAY_TIMEZONE=Asia/Kolkata
TERMS_VERSION=2025-01-01
